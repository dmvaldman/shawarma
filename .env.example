# Copy to .env. Set local-only development credentials before starting Compose.
POSTGRES_PASSWORD=change-local-postgres-password
HARNESS_DB_PASSWORD=change-local-harness-password
MATTERMOST_IMAGE=mattermost/mattermost-team-edition:10.11.0
MATTERMOST_SITE_URL=http://localhost:8065
HARNESS_MATTERMOST_URL=http://localhost:8065
HARNESS_MATTERMOST_SERVER_ID=local-server
HARNESS_DATABASE_URL=postgresql+asyncpg://harness:change-local-harness-password@localhost:5432/harness
HARNESS_MATTERMOST_ADMIN_TOKEN=
HARNESS_MATTERMOST_OWNER_ID=
HARNESS_MAX_ACTIVE_AGENTS=100
HARNESS_MAX_CONCURRENT_LLM_CALLS=10
HARNESS_MAX_TOKENS_PER_TURN=4096
HARNESS_TOOL_TIMEOUT_SEC=90

# Model provider credentials for M2. One provider key is enough to start.
# Fill these locally; never paste credentials into chat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Explicit M2 model selection and conservative usage prices (USD per million tokens).
HARNESS_OPENAI_BASE_URL=https://api.openai.com/v1
HARNESS_OPENAI_MODEL_ID=gpt-6-luna
HARNESS_OPENAI_MODEL_LABEL=OpenAI gpt-6-luna
HARNESS_INPUT_USD_PER_MILLION=0.25
HARNESS_OUTPUT_USD_PER_MILLION=0.75
HARNESS_NOTIFICATION_BATCH_SIZE=10
HARNESS_MAX_TOOL_CALLS_PER_TURN=12
HARNESS_LLM_REQUEST_TIMEOUT_SEC=120

# Naming, cached model discovery, and explicit owner-approved prompt deployment.
HARNESS_WORKSPACE_NAME=My Swarm
HARNESS_COORDINATION_CHANNEL_NAME=town-square
HARNESS_MODEL_CACHE_TTL_SEC=3600
HARNESS_UNKNOWN_INPUT_USD_PER_MILLION=100
HARNESS_UNKNOWN_OUTPUT_USD_PER_MILLION=500
HARNESS_OWNER_PROMPT_REVISION=1.33.0:6ee89a1745ee6cda26fe459f399cac80bbc409d606fb33ff8ea516103c119dd8

# Shared retrieval and natural channel delivery
HARNESS_WEB_SEARCH_MODEL_ID=gpt-6-luna
HARNESS_CHANNEL_DELIVERY_MIN_SEC=0.5
HARNESS_CHANNEL_DELIVERY_MAX_SEC=3
HARNESS_TYPING_YIELD_MAX_SEC=3

# Native slash controls: Mattermost container calls the host-side listener.
HARNESS_SLASH_BIND_HOST=0.0.0.0
HARNESS_SLASH_PORT=8766
HARNESS_SLASH_CALLBACK_URL=http://host.docker.internal:8766/mattermost/commands
MATTERMOST_ALLOWED_INTERNAL_CONNECTIONS=host.docker.internal
HARNESS_IDLE_CHANNEL_POLL_SEC=30

# Read-only analytics dashboard (loopback only)
HARNESS_ANALYTICS_PORT=8066

# Optional provider billing credentials, separate from inference keys
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=

# Persistent OpenCode coding worker + shared Gitea; provision with agent-company-coding.
# Run `agent-company-coding up` for Docker or `cloud-up` for an Agent37 VM.
# Provisioning writes generated worker credentials to .env and .state/coding.json.
AGENT37_API_KEY=
HARNESS_CODING_ENABLED=false
# `agent-company-coding up` selects opencode after provisioning the worker.
HARNESS_AGENT_ENGINE=provider
HARNESS_SWARM_TOOL_BIND_HOST=0.0.0.0
HARNESS_SWARM_TOOL_PORT=8767
HARNESS_SWARM_TOOL_URL=http://host.docker.internal:8767
HARNESS_SWARM_TOOL_KEY=
HARNESS_CODING_BACKEND=docker
HARNESS_AGENT37_INSTANCE_ID=
HARNESS_OPENCODE_URL=http://127.0.0.1:4096
HARNESS_OPENCODE_PASSWORD=
HARNESS_GITEA_URL=http://127.0.0.1:3000
HARNESS_GITEA_WORKER_URL=http://gitea:3000
HARNESS_GITEA_OWNER=swarm
HARNESS_GITEA_REPO=workspace
HARNESS_GITEA_TOKEN=
HARNESS_CODING_TIMEOUT_SEC=600

# Role-based profile images generated asynchronously, once per agent.
HARNESS_AVATARS_ENABLED=true
HARNESS_AVATAR_MODEL=gpt-image-2.5-flare

# Hosted deployments only: REST stays local; browser links use private edge URLs.
HARNESS_MATTERMOST_PUBLIC_URL=
HARNESS_GITEA_PUBLIC_URL=
HARNESS_OPENCODE_PUBLIC_URL=
HARNESS_ANALYTICS_PUBLIC_URL=
